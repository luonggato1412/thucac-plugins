+private data class TestLine(val text: String, val link: String? = null)
+
+/** "Thử plugin": run each script of a source plugin and look at its files. */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun PluginTestScreen(nav: NavHostController, id: String) {
+    val app = App.instance
+    val plugin = app.sources.get(id)
+    if (plugin == null) { Scaffold { EmptyBox("Plugin đã bị gỡ.", Modifier.padding(it)) }; return }
+    var tab by remember { mutableIntStateOf(0) }
+    val funcs = listOf("home", "genre", "search", "detail", "toc", "chap").filter { plugin.hasScript(it) }
+    var func by remember { mutableStateOf(funcs.firstOrNull() ?: "home") }
+    var input by remember { mutableStateOf("") }
+    var running by remember { mutableStateOf(false) }
+    var result by remember { mutableStateOf<List<TestLine>>(emptyList()) }
+    var status by remember { mutableStateOf("") }
+    var openFile by remember { mutableStateOf<String?>(null) }
+    val scope = rememberCoroutineScope()
+
+    fun run() {
+        running = true; result = emptyList(); status = ""
+        val f = func; val inp = input.trim()
+        scope.launch {
+            val t0 = System.currentTimeMillis()
+            val r = withContext(Dispatchers.IO) {
+                runCatching {
+                    val api = app.sources.api(id)
+                    when (f) {
+                        "home", "genre" -> (if (f == "home") api.home() else api.genres()).map { TestLine("${it.title}\n  script: ${it.script} · input: ${it.input}") }
+                        "search" -> api.search(inp, null).let { p -> p.items.map { TestLine("${it.name}\n  ${it.url}", it.url) } + TestLine("next: ${p.next ?: "(hết)"}") }
+                        "detail" -> api.detail(inp).let { d ->
+                            listOf(TestLine("Tên: ${d.name}"), TestLine("Tác giả: ${d.author}"), TestLine("Bìa: ${d.cover}"),
+                                TestLine("Trạng thái: ${when (d.ongoing) { true -> "Đang ra"; false -> "Hoàn thành"; null -> "?" }}"),
+                                TestLine("Mô tả: ${d.description.take(600)}"), TestLine("Chi tiết: ${d.detail.take(600)}"),
+                                TestLine("Thể loại: ${d.genres.joinToString { it.title }}"), TestLine("Url: ${d.url}", d.url.ifEmpty { inp }))
+                        }
+                        "toc" -> api.toc(inp).let { l -> listOf(TestLine("${l.size} chương")) + l.take(200).map { TestLine("${it.name}${if (it.pay) " (VIP)" else ""}\n  ${it.url}", it.url) } }
+                        else -> when {
+                            plugin.isComic -> api.comicPages(inp).let { l -> listOf(TestLine("${l.size} ảnh")) + l.map { TestLine(it.link) } }
+                            plugin.isVideo -> api.videoServers(inp).map { TestLine("${it.title}\n  ${it.data.take(300)}") }
+                            else -> api.chapter(inp).let { c -> listOf(TestLine("${c.length} ký tự"), TestLine(c.take(8000))) }
+                        }
+                    }
+                }
+            }
+            val ms = System.currentTimeMillis() - t0
+            r.fold({ result = it; status = "Xong trong $ms ms · ${it.size} dòng" }, { status = "Lỗi sau $ms ms"; result = listOf(TestLine(it.stackTraceToString().take(4000))) })
+            running = false
+        }
+    }
+
+    Scaffold(topBar = { SimpleTop(nav, "Thử plugin: ${plugin.name}") }) { pad ->
+        Column(Modifier.padding(pad).fillMaxSize()) {
+            TabRow(tab) {
+                Tab(tab == 0, { tab = 0 }, text = { Text("Chạy thử") })
+                Tab(tab == 1, { tab = 1 }, text = { Text("Mã nguồn") })
+            }
+            if (tab == 0) {
+                Row(Modifier.horizontalScroll(rememberScrollState()).padding(horizontal = 12.dp, vertical = 6.dp), horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+                    funcs.forEach { f -> FilterChip(func == f, { func = f }, label = { Text(f) }) }
+                }
+                if (func !in listOf("home", "genre")) OutlinedTextField(
+                    input, { input = it }, singleLine = true, modifier = Modifier.fillMaxWidth().padding(horizontal = 12.dp),
+                    label = { Text(if (func == "search") "Từ khoá" else "Url") },
+                )
+                Row(Modifier.padding(12.dp), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    Button(onClick = { run() }, enabled = !running) { Text("Chạy") }
+                    if (func != "search" && input.startsWith("http")) OutlinedButton(onClick = { nav.navigate(Routes.web(input.trim())) }) { Text("Mở trang web") }
+                }
+                if (running) LinearProgressIndicator(Modifier.fillMaxWidth())
+                if (status.isNotEmpty()) Text(status, style = MaterialTheme.typography.labelMedium, modifier = Modifier.padding(horizontal = 12.dp))
+                val next = mapOf("search" to "detail", "detail" to "toc", "toc" to "chap")[func]
+                if (next != null && result.any { it.link != null }) Text("Chạm một kết quả để chạy tiếp \"$next\"", style = MaterialTheme.typography.labelSmall, color = MaterialTheme.colorScheme.onSurfaceVariant, modifier = Modifier.padding(horizontal = 12.dp))
+                LazyColumn(Modifier.fillMaxSize()) {
+                    items(result) { l ->
+                        SelectionContainer {
+                            Text(l.text, fontFamily = FontFamily.Monospace, fontSize = 12.sp,
+                                modifier = Modifier.fillMaxWidth().then(if (l.link != null && next != null) Modifier.clickable { input = l.link; func = next; run() } else Modifier).padding(horizontal = 12.dp, vertical = 4.dp))
+                        }
+                        HorizontalDivider()
+                    }
+                }
+            } else {
+                val files = remember(id) { runCatching { PluginStore.files(plugin) }.getOrDefault(emptyList()) }
+                LazyColumn(Modifier.fillMaxSize()) {
+                    items(files) { f ->
+                        Text(f, fontFamily = FontFamily.Monospace, modifier = Modifier.fillMaxWidth().clickable { openFile = f }.padding(16.dp, 12.dp))
+                        HorizontalDivider()
+                    }
+                }
+            }
+        }
+    }
+    openFile?.let { f ->
+        val text = remember(f) { runCatching { File(plugin.dir, f).let { if (it.length() > 400_000) "(file quá lớn: ${it.length()} byte)" else it.readText() } }.getOrElse { it.message ?: "Lỗi đọc file" } }
+        AlertDialog(
+            onDismissRequest = { openFile = null },
+            title = { Text(f, maxLines = 1, overflow = TextOverflow.Ellipsis) },
+            text = {
+                SelectionContainer {
+                    Text(text, fontFamily = FontFamily.Monospace, fontSize = 11.sp,
+                        modifier = Modifier.height(480.dp).verticalScroll(rememberScrollState()).horizontalScroll(rememberScrollState()))
+                }
+            },
+            confirmButton = { TextButton(onClick = { openFile = null }) { Text("Đóng") } },
+        )
+    }
+}
