+    /** Models the key can use, newest first: Gemini models.list, or GET /models for OpenAI-style APIs. */
+    fun listModels(provider: AiProvider, key: String, baseUrl: String = provider.baseUrl): List<String> {
+        val base = baseUrl.trim().trimEnd('/')
+        val k = key.trim()
+        require(k.isNotEmpty()) { "Chưa nhập API key" }
+        val req = when (provider.api) {
+            AiApi.GEMINI -> HttpRequest("$base/models?pageSize=1000", "GET", mapOf("x-goog-api-key" to k), null)
+            AiApi.OPENAI -> HttpRequest("$base/models", "GET", mapOf("Authorization" to "Bearer $k"), null)
+            AiApi.CLAUDE -> HttpRequest("$base/models", "GET", mapOf("x-api-key" to k, "anthropic-version" to "2023-06-01"), null)
+        }
+        val r = fetcher.fetch(req)
+        if (!r.ok) throw ScriptException("Không lấy được danh sách model (HTTP ${r.status})")
+        val o = JSONObject(String(r.body, Charsets.UTF_8))
+        val out = ArrayList<String>()
+        o.optJSONArray("models")?.let { arr ->
+            for (i in 0 until arr.length()) {
+                val m = arr.optJSONObject(i) ?: continue
+                val methods = m.optJSONArray("supportedGenerationMethods")?.toString().orEmpty()
+                if (methods.isNotEmpty() && !methods.contains("generateContent")) continue
+                val name = m.optString("name").removePrefix("models/")
+                if (name.startsWith("gemini")) out.add(name)
+            }
+        }
+        o.optJSONArray("data")?.let { arr -> for (i in 0 until arr.length()) arr.optJSONObject(i)?.optString("id")?.takeIf { it.isNotEmpty() }?.let { out.add(it) } }
+        // Newest version first, then flash-lite / flash before pro, so the first entry is a sensible default.
+        fun ver(n: String) = Regex("(\\d+(?:\\.\\d+)?)").find(n)?.value?.toDoubleOrNull() ?: 0.0
+        return out.distinct().sortedWith(compareByDescending<String> { ver(it) }.thenBy { if (it.contains("flash")) 0 else 1 }.thenBy { it })
+    }
