+    class StageException(val stage: String, message: String) : Exception("$stage: $message")
+
+    /**
+     * Like [ocr] but reports each step through [onStage] and throws [StageException] instead of returning null.
+     * [lang] ("en", "ko", "zh" or null for unknown) picks one recognizer, which is much faster than running all three.
+     */
+    fun ocrStaged(url: String, http: OkHttpClient, referer: String?, lang: String?, onStage: (String) -> Unit): OcrResult {
+        val key = sha1(url)
+        mem[key]?.let { return it }
+        for (name in listOf("o8-${lang ?: "all"}-$key.json")) {
+            val f = File(dir, name)
+            if (f.exists()) OcrResult.fromJson(f.readText())?.let { mem[key] = it; return it }
+        }
+        onStage("Tải ảnh")
+        val req = Request.Builder().url(url).apply {
+            if (referer != null) header("Referer", referer)
+            header("User-Agent", vn.thucac.reader.App.instance.userAgent)
+        }.build()
+        val bytes = try {
+            http.newCall(req).execute().use { resp ->
+                if (!resp.isSuccessful) throw StageException("Tải ảnh", "máy chủ trả mã ${resp.code}")
+                resp.body?.bytes() ?: throw StageException("Tải ảnh", "ảnh rỗng")
+            }
+        } catch (e: StageException) { throw e } catch (e: Exception) {
+            throw StageException("Tải ảnh", e.message ?: e.javaClass.simpleName)
+        }
+        onStage("Nhận chữ" + when (lang) { "en" -> " (Anh)"; "ko" -> " (Hàn)"; "zh" -> " (Trung)"; else -> "" })
+        val res = runOcr(bytes, lang)
+        mem[key] = res
+        runCatching { File(dir, "o8-${lang ?: "all"}-$key.json").writeText(res.toJson()) }
+        return res
+    }
+
+    private fun runOcr(bytes: ByteArray, lang: String?): OcrResult {
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeByteArray(bytes, 0, bytes.size, bounds)
+        val origW = bounds.outWidth
+        val origH = bounds.outHeight
+        if (origW <= 0 || origH <= 0) throw StageException("Đọc ảnh", "không giải mã được ảnh (${bytes.size} byte)")
+        var sample = 1
+        while (origW / sample > 1600) sample *= 2
+        val opts = BitmapFactory.Options().apply { inSampleSize = sample; inPreferredConfig = Bitmap.Config.ARGB_8888 }
+        val bmp = BitmapFactory.decodeByteArray(bytes, 0, bytes.size, opts) ?: throw StageException("Đọc ảnh", "không đủ bộ nhớ để mở ảnh")
+        val recognizers = when (lang) {
+            "en" -> listOf(latin)
+            "ko" -> listOf(korean)
+            "zh" -> listOf(chinese)
+            else -> listOf(latin, korean, chinese)
+        }
+        try {
+            val scaleX = origW.toFloat() / bmp.width
+            val scaleY = origH.toFloat() / bmp.height
+            val raw = mutableListOf<OcrBlock>()
+            var calls = 0
+            var fails = 0
+            var lastError = ""
+            var y0 = 0
+            while (y0 < bmp.height) {
+                val y1 = min(bmp.height, y0 + 1600)
+                val tile = Bitmap.createBitmap(bmp, 0, y0, bmp.width, y1 - y0)
+                try {
+                    val img = InputImage.fromBitmap(tile, 0)
+                    for (r in recognizers) {
+                        calls++
+                        val out = runCatching { Tasks.await(r.process(img), 20, TimeUnit.SECONDS) }
+                        out.exceptionOrNull()?.let { fails++; lastError = it.message ?: it.javaClass.simpleName }
+                        collectLines(out.getOrNull(), bmp, y0, scaleX, scaleY, raw)
+                    }
+                } finally {
+                    tile.recycle()
+                }
+                if (y1 >= bmp.height) break
+                y0 = y1 - 240
+            }
+            if (calls > 0 && fails == calls) throw StageException("Nhận chữ", "ML Kit lỗi ($lastError). Có thể mô hình nhận chữ chưa tải xong, thử lại sau ít phút")
+            val merged = mergeBlocks(OcrResult(origW, origH, dedupLines(raw)))
+            return OcrResult(origW, origH, merged)
+        } finally {
+            bmp.recycle()
+        }
+    }
