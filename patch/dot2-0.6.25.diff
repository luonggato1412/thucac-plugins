+private val bmTime = SimpleDateFormat("dd/MM/yyyy HH:mm", Locale.getDefault())
+
+/** All bookmarks and notes, or only those of one book when [bookKey] is set. */
+@Composable
+fun BookmarksScreen(nav: NavHostController, bookKey: String = "") {
+    val app = App.instance
+    val tr = app.translator
+    val list = (if (bookKey.isEmpty()) app.bookmarks.all.sortedByDescending { it.time } else app.bookmarks.of(bookKey))
+    var editing by remember { mutableStateOf<Bookmark?>(null) }
+    Scaffold(topBar = { SimpleTop(nav, "Dấu trang & ghi chú") }) { pad ->
+        if (list.isEmpty()) EmptyBox("Chưa có dấu trang.\nTrong trình đọc, bấm giữ một đoạn văn rồi chọn \"Thêm dấu trang\" hoặc \"Ghi chú\".", Modifier.padding(pad).fillMaxSize())
+        else LazyColumn(Modifier.padding(pad).fillMaxSize()) {
+            items(list, key = { it.id }) { b ->
+                BookmarkRow(b, showBook = bookKey.isEmpty(), onOpen = { nav.navigate(Routes.reader(b.pluginId, b.bookUrl, b.chapterIndex, b.para)) },
+                    onEdit = { editing = b }, onDelete = { app.bookmarks.remove(b.id) })
+                HorizontalDivider()
+            }
+        }
+    }
+    editing?.let { b -> NoteDialog(b.note, onDismiss = { editing = null }) { app.bookmarks.updateNote(b.id, it); editing = null } }
+}
+
+@Composable
+internal fun BookmarkRow(b: Bookmark, showBook: Boolean, onOpen: () -> Unit, onEdit: () -> Unit, onDelete: () -> Unit) {
+    val tr = App.instance.translator
+    Row(Modifier.fillMaxWidth().clickable(onClick = onOpen).padding(start = 16.dp, top = 8.dp, bottom = 8.dp)) {
+        Column(Modifier.weight(1f)) {
+            if (showBook) Text(tr.title(b.bookName, b.bookKey), style = MaterialTheme.typography.titleSmall, maxLines = 1, overflow = TextOverflow.Ellipsis)
+            Text("Chương ${b.chapterIndex + 1}: ${tr.text(b.chapterName, bookKey = b.bookKey)}", style = MaterialTheme.typography.labelMedium, color = MaterialTheme.colorScheme.primary, maxLines = 1, overflow = TextOverflow.Ellipsis)
+            if (b.excerpt.isNotBlank()) Text(b.excerpt, style = MaterialTheme.typography.bodySmall, maxLines = 3, overflow = TextOverflow.Ellipsis)
+            if (b.note.isNotBlank()) Text("Ghi chú: " + b.note, style = MaterialTheme.typography.bodyMedium, color = MaterialTheme.colorScheme.tertiary)
+            Text(bmTime.format(Date(b.time)), style = MaterialTheme.typography.labelSmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        }
+        IconButton(onClick = onEdit) { Icon(Icons.Default.Edit, "Sửa ghi chú") }
+        IconButton(onClick = onDelete) { Icon(Icons.Default.Delete, "Xoá") }
+    }
+}
