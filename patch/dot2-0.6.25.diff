+@Composable
+internal fun NoteDialog(initial: String, onDismiss: () -> Unit, onSave: (String) -> Unit) {
+    var text by remember { mutableStateOf(initial) }
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text("Ghi chú") },
+        text = { OutlinedTextField(text, { text = it }, minLines = 3, modifier = Modifier.fillMaxWidth(), placeholder = { Text("Viết ghi chú cho đoạn này") }) },
+        confirmButton = { TextButton(onClick = { onSave(text.trim()) }) { Text("Lưu") } },
+        dismissButton = { TextButton(onClick = onDismiss) { Text("Huỷ") } },
+    )
+}
